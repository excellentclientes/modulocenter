{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/admin.html", "destination": "/", "permanent": true },
    { "source": "/admin", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!js/|css/|img/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
