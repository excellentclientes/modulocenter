rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Só a conta Google abaixo pode escrever. Deve ser o MESMO e-mail de js/admin-config.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["excellentservices.excel@gmail.com"];
    }

    // Qualquer visitante pode LER o site; só o administrador pode ESCREVER.
    match /site/{doc}       { allow read: if true; allow write: if isAdmin(); }
    match /produtos/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /imagens/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /avaliacoes/{id}  { allow read: if true; allow write: if isAdmin(); }
  }
}
